{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!assets/|sample-books/|favicon.ico|manifest.json|sw.js).*)",
      "destination": "/index.html"
    }
  ]
}
