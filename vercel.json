{
  "version": 2,
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://athenaeum-bookstore.onrender.com/api/$1"
    },
    {
      "source": "/((?!assets/|favicon.ico|manifest.json|sw.js).*)",
      "destination": "/index.html"
    }
  ]
}
